{
  "name": "jvdv-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "build": "astro build",
    "postbuild": "node scripts/sitemap.mjs",
    "preview": "wrangler dev --ip 127.0.0.1 --port 4322",
    "test": "playwright test",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "deploy": "npm run check && npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "astro": "7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.3",
    "typescript": "6.0.3",
    "wrangler": "4.151.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
