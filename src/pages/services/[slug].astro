---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Band from '../../components/Band.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { services, steps, type Service } from '../../data/services';
import { projects } from '../../data/projects';
import { site } from '../../data/site';

export const getStaticPaths = (() => services.map(service => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props { service: Service; }
const { service } = Astro.props;
const { page } = service;
const path = `/services/${service.slug}`;
const related = page.related.map(key => projects[key]);
const others = services.filter(other => other.slug !== service.slug);
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  serviceType: service.title,
  description: page.metaDescription,
  url: new URL(path, Astro.site!).href,
  provider: { '@id': `${Astro.site!.href}#studio` },
  areaServed: [{ '@type': 'City', name: 'Melbourne' }, { '@type': 'Country', name: 'Australia' }],
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map(faq => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })),
};
---
<Base
  title={page.seoTitle}
  description={page.metaDescription}
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Services', href: '/services' }, { name: service.title, href: path }]}
  jsonLd={[serviceLd, faqLd]}
>
  <p class="breadcrumb"><a href="/services">Services</a> / {service.title}</p>
  <section class="panel hero" style="margin-top: 0">
    <div class="hero__main">
      <p class="note note--accent">{service.title.toLowerCase()}</p>
      <h1 style="max-width: 18ch">{page.h1}</h1>
    </div>
    <div class="hero__side">
      <p class="lead">{page.lead}</p>
      <a class="button" href="/contact">Book a free consult</a>
    </div>
  </section>

  <section class="section split" aria-labelledby="intro-heading">
    <div>
      <h2 id="intro-heading">How we approach it</h2>
    </div>
    <div class="service-intro">
      {page.intro.map(paragraph => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="section" aria-labelledby="features-heading">
    <h2 id="features-heading" style="margin-bottom: 32px">What’s included</h2>
    <ul class="grid grid--tight">
      {page.features.map(feature => <li class="tile"><h3>{feature.title}</h3><p>{feature.text}</p></li>)}
    </ul>
  </section>

  <section class="section split" aria-labelledby="audience-heading">
    <div>
      <h2 id="audience-heading">Who it’s for</h2>
      <p class="note note--accent">sound familiar?</p>
    </div>
    <ul class="ticks service-audience">
      {page.audience.map(item => <li>{item}</li>)}
    </ul>
  </section>

  {related.length > 0 && (
    <section class="section" aria-labelledby="related-heading">
      <div class="section-head">
        <h2 id="related-heading">Related work</h2>
        <a class="muted" href="/work">All case studies</a>
      </div>
      <div class="grid" style="--min: 420px">
        {related.map(project => <ProjectCard project={project} />)}
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="process-heading">
    <h2 id="process-heading" style="margin-bottom: 32px">How a project runs</h2>
    <ol class="steps">
      {steps.map(step => <li><strong>{step.title}</strong><span>{step.text}</span></li>)}
    </ol>
  </section>

  <section class="section split" aria-labelledby="faq-heading">
    <div>
      <h2 id="faq-heading">Questions about {service.title.toLowerCase()}</h2>
      <p class="muted">Something else on your mind? <a class="text-link" href="/contact">Ask us directly.</a></p>
    </div>
    <div class="faq">
      {page.faqs.map((faq, index) => <details open={index === 0}><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}
    </div>
  </section>

  <section class="section" aria-labelledby="other-heading">
    <h2 id="other-heading" style="margin-bottom: 24px">Other services</h2>
    <ul class="other-services">
      {others.map(other => <li><a href={`/services/${other.slug}`}>{other.title}</a></li>)}
    </ul>
  </section>

  <Band note="let’s talk" heading={`Ready to start? Tell ${site.name} what you need.`} />
</Base>

<style>
  .service-intro { display: flex; flex-direction: column; gap: 18px; max-width: 68ch; }
  .service-intro p { color: var(--muted); font-size: 18px; }
  .service-audience { font-size: 18px; }
  .other-services { display: flex; flex-wrap: wrap; gap: 10px; }
  .other-services a { display: inline-flex; align-items: center; min-height: 44px; padding: 10px 18px; border: 1px solid var(--line); border-radius: 999px; text-decoration: none; color: var(--muted); }
</style>
