---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import Trusted from '../components/Trusted.astro';
import ProjectCard from '../components/ProjectCard.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { projects, findCardsScreens } from '../data/projects';

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  alternateName: site.shortName,
  url: Astro.site!.href,
  publisher: { '@id': `${Astro.site!.href}#studio` },
};
---
<Base
  title="Web Design & App Development in Melbourne | JVDV Studio"
  description="JVDV Studio is a Melbourne web design and app development studio. We design, build and look after websites, Shopify stores and apps for businesses that want results."
  jsonLd={[websiteLd]}
>
  <section class="panel hero" style="align-items: center; gap: 48px">
    <div class="hero__main" style="gap: 28px">
      <p class="note note--accent">Melbourne design and development studio</p>
      <h1 style="font-size: clamp(40px, 5.4vw, 76px); max-width: 15ch">Websites and apps that pull their weight.</h1>
      <p class="lead">{site.name} is a web design and app development studio in Melbourne. We design, build and look after websites, e-commerce stores and apps for businesses that want results they can measure.</p>
      <div class="actions">
        <a class="button" href="/contact">Book a free consult</a>
        <a class="button button--outline" href="/work">See our work</a>
      </div>
    </div>
    <Shot label="FIND Cards app screens" screens={[findCardsScreens.home, findCardsScreens.deal, findCardsScreens.map]} ratio="1 / 1" priority class="home-hero-shot" />
  </section>

  <Trusted />

  <section class="section" aria-labelledby="work-heading">
    <div class="section-head">
      <h2 id="work-heading">Recent work</h2>
      <a class="muted" href="/work">All case studies</a>
    </div>
    <div class="grid" style="--min: 480px">
      <ProjectCard project={projects.homeward} />
      <ProjectCard project={projects.foxwood} />
    </div>
  </section>

  <section class="section" aria-labelledby="services-heading">
    <div class="section-head">
      <h2 id="services-heading" style="max-width: 16ch">Everything your business needs online</h2>
      <p class="muted">Strategy, design, development and support from one team, so nothing falls between suppliers.</p>
    </div>
    <ul class="grid grid--tight">
      {services.map(service => <li class="tile"><h3><a href={`/services/${service.slug}`} style="text-decoration: none">{service.title}</a></h3><p>{service.summary}</p></li>)}
    </ul>
  </section>

  <section class="section">
    <div class="band" style="align-items: flex-end">
      <p style="flex: 3 1 520px; font-family: var(--display); font-weight: 600; font-size: clamp(28px, 3.2vw, 44px); line-height: 1.12; letter-spacing: -0.03em">We don’t launch and leave. We host what we build, look after it and keep improving it.</p>
      <div style="flex: 2 1 300px; gap: 12px">
        <p class="note">from the studio</p>
        <p style="max-width: 44ch">{site.name} works with retailers, service businesses and platform founders across Australia. <a href="/about" style="font-weight: 600">More about the studio</a></p>
      </div>
    </div>
  </section>

  <section class="section split" aria-labelledby="contact-heading">
    <div>
      <h2 id="contact-heading" style="font-size: clamp(36px, 4vw, 56px)">Book a free consult</h2>
      <p class="muted">Tell us about your project and we’ll come back within one business day with ideas and next steps.</p>
      <p style="font-size: 15px"><a class="text-link" href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
    <div class="card" style="padding: clamp(24px, 3vw, 40px)">
      <EnquiryForm />
    </div>
  </section>
</Base>

<style>
  :global(.home-hero-shot) { flex: 2 1 340px; border-radius: 24px; }
</style>
