---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Band from '../../components/Band.astro';
import { site } from '../../data/site';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const path = `/blog/${post.id}`;
const format = (date: Date) => date.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Australia/Melbourne' });
const iso = (date: Date) => date.toISOString().slice(0, 10);
const postLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: iso(post.data.date),
  dateModified: iso(post.data.updated ?? post.data.date),
  author: { '@type': 'Person', name: site.founder, url: new URL('/about', Astro.site!).href },
  publisher: { '@id': `${Astro.site!.href}#studio` },
  mainEntityOfPage: new URL(path, Astro.site!).href,
  inLanguage: 'en-AU',
};
---
<Base
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.description}
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Blog', href: '/blog' }, { name: post.data.title, href: path }]}
  jsonLd={[postLd]}
>
  <p class="breadcrumb"><a href="/blog">Blog</a> / Guide</p>
  <article class="post">
    <header class="panel hero post__head" style="margin-top: 0">
      <div class="hero__main">
        <p class="note note--accent">a guide from the studio</p>
        <h1 style="max-width: 22ch; font-size: clamp(34px, 4.2vw, 56px)">{post.data.title}</h1>
        <p class="dim post__meta">
          By {site.founder}, <time datetime={iso(post.data.date)}>{format(post.data.date)}</time>
          {post.data.updated && <>, updated <time datetime={iso(post.data.updated)}>{format(post.data.updated)}</time></>}
        </p>
      </div>
    </header>
    <div class="section prose">
      <Content />
    </div>
  </article>

  <Band note="need a hand?" heading="Tell us what you need. We’ll give you a straight answer." />
</Base>

<style>
  .post__head { margin-bottom: 0; }
  .post__meta { font-size: 15px; }
  .prose { max-width: 70ch; }
  .prose :global(p), .prose :global(li) { color: var(--muted); font-size: 18px; line-height: 1.65; }
  .prose :global(p + p), .prose :global(ul + p), .prose :global(p + ul) { margin-top: 18px; }
  .prose :global(h2) { font-size: clamp(26px, 2.8vw, 36px); margin-top: 56px; margin-bottom: 16px; }
  .prose :global(h3) { font-size: 22px; margin-top: 36px; margin-bottom: 10px; }
  .prose :global(ul) { list-style: disc; padding-left: 22px; display: flex; flex-direction: column; gap: 10px; }
  .prose :global(li::marker) { color: var(--accent); }
  .prose :global(a) { color: var(--accent); font-weight: 500; }
  .prose :global(strong) { color: var(--text); }
  @media (max-width: 700px) {
    .prose :global(p), .prose :global(li) { font-size: 17px; }
    .prose :global(h2) { margin-top: 44px; }
  }
</style>
