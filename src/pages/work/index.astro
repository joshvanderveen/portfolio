---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Band from '../../components/Band.astro';
import { projects, categories } from '../../data/projects';

const all = Object.values(projects);
// Only offer filters that match at least one project.
const filters = categories.filter(category => all.some(project => (project.categories as string[]).includes(category.id)));
---
<Base title="Work" description="Platforms, apps and websites JVDV has designed, built and still looks after, including FIND Cards, Trakkrr and Foxwood Media.">
  <section class="panel hero">
    <div class="hero__main">
      <p class="note note--accent">things we’ve made</p>
      <h1 style="max-width: 16ch">Work that earns its keep.</h1>
    </div>
    <p class="lead hero__side">Platforms, apps and websites we’ve designed, built and still look after for businesses across Australia.</p>
  </section>

  <div class="work-filters" data-filters hidden role="group" aria-label="Filter projects">
    <button class="filter" type="button" data-filter="all" aria-pressed="true">All work</button>
    {filters.map(filter => <button class="filter" type="button" data-filter={filter.id} aria-pressed="false">{filter.label}</button>)}
  </div>

  <div class="grid work-grid" style="--min: 420px">
    {all.map(project => <ProjectCard project={project} heading="h2" />)}
  </div>
  <p class="muted work-empty" data-empty hidden>No projects in this category yet.</p>

  <Band note="your turn" heading="Got a project like these in mind?" />
</Base>

<style>
  .work-filters { display: flex; flex-wrap: wrap; gap: 10px; padding-top: 40px; }
  .filter { min-height: 44px; padding: 10px 18px; border: 1px solid var(--line); border-radius: 999px; background: transparent; color: var(--muted); font-size: 15px; cursor: pointer; }
  .filter[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .work-grid { padding-top: 24px; }
  .work-empty { padding-top: 24px; }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filters]')!;
  const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('.work-grid [data-categories]')];
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  bar.hidden = false;
  for (const button of buttons) {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter!;
      for (const other of buttons) other.setAttribute('aria-pressed', String(other === button));
      let shown = 0;
      for (const card of cards) {
        const match = filter === 'all' || card.dataset.categories!.split(' ').includes(filter);
        card.hidden = !match;
        if (match) shown++;
      }
      empty.hidden = shown > 0;
    });
  }
</script>
