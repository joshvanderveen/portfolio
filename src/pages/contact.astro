---
import Base from '../layouts/Base.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site } from '../data/site';

const next = [
  { title: 'We reply', text: 'within one business day to set up a call.' },
  { title: 'A free consult', text: 'of about 30 minutes to understand your goals.' },
  { title: 'A fixed quote', text: 'with scope and timeline, usually within a week.' },
];
---
<Base title="Contact JVDV Studio | Free Website & App Consult" description="Tell JVDV Studio about your website, store or app project. We reply within one business day, and every project starts with a free consult." breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Contact', href: '/contact' }]}>
  <section class="hero contact-hero">
    <div class="hero__main" style="gap: 20px">
      <p class="note note--accent">we reply within one business day</p>
      <h1 style="max-width: 16ch">Let’s talk about your project.</h1>
    </div>
    <p class="lead hero__side">Tell us a little about what you need. The more we know, the more useful our first conversation will be.</p>
  </section>

  <section class="contact-layout section">
    <div class="card contact-form">
      <EnquiryForm variant="full" />
    </div>
    <aside class="contact-aside">
      <div class="tile">
        <h2>What happens next</h2>
        <ol class="next-steps">
          {next.map(step => <li><span><strong>{step.title}</strong> {step.text}</span></li>)}
        </ol>
      </div>
      <div class="tile">
        <h2>Prefer to reach out directly?</h2>
        <dl class="contact-list">
          <dt>Email</dt><dd><a class="text-link" href={`mailto:${site.email}`}>{site.email}</a></dd>
          {site.phone && <><dt>Phone</dt><dd><a href={`tel:${site.phone.replace(/\s+/g, '')}`}>{site.phone}</a></dd></>}
          <dt>Based in</dt><dd>{site.location}</dd>
          <dt>Elsewhere</dt><dd><a href={site.linkedin}>LinkedIn</a> and <a href={site.github}>GitHub</a></dd>
        </dl>
      </div>
    </aside>
  </section>
</Base>

<style>
  .contact-hero { padding-top: clamp(40px, 6vw, 80px); }
  .contact-layout { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 20px; padding-top: 40px; }
  .contact-form { flex: 3 1 600px; padding: clamp(24px, 3.5vw, 48px); }
  .contact-aside { flex: 2 1 340px; display: flex; flex-direction: column; gap: 20px; }
  .contact-aside .tile { border-radius: 28px; gap: 20px; }
  .contact-aside h2 { font-size: 24px; letter-spacing: -0.02em; }
  .next-steps { display: flex; flex-direction: column; gap: 18px; counter-reset: next; }
  .next-steps li { counter-increment: next; display: flex; gap: 16px; color: var(--muted); }
  .next-steps li::before { content: counter(next); flex: 0 0 32px; height: 32px; border-radius: 50%; background: var(--accent); color: var(--on-accent); display: flex; align-items: center; justify-content: center; font-family: var(--display); font-weight: 700; font-size: 15px; }
  .next-steps strong { color: var(--text); font-weight: 600; }
  .contact-list { display: grid; grid-template-columns: max-content 1fr; gap: 10px 20px; font-size: 16px; }
  .contact-list dt { color: var(--dim); }
</style>
