---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="panel hero">
    <div class="hero__main">
      <p class="note note--accent">well, this is awkward</p>
      <h1>We can’t find that page.</h1>
      <p class="lead">It may have moved, or the link might be mistyped.</p>
      <div class="actions">
        <a class="button" href="/">Go to the home page</a>
        <a class="button button--outline" href="/work">See our work</a>
      </div>
    </div>
  </section>
  <div class="section"></div>
</Base>
